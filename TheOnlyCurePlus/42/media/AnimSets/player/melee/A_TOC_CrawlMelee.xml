<?xml version="1.0" encoding="utf-8"?>
<animNode>
	<m_Name>A_TOC_CrawlMelee</m_Name>
	<m_Priority>10</m_Priority>
	<m_AnimName>Zombie_CrawlLunge</m_AnimName>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.20</m_BlendTime>
	<m_EarlyTransitionOut>true</m_EarlyTransitionOut>
	<m_SpeedScale>0.90</m_SpeedScale>
	<m_Conditions x_name="toc-toc_crawl">
		<m_Name>TOC_Crawl</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions x_name="toc-toc_crawl2">
		<m_Name>TOC_Crawl2</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions x_name="toc-toc_crawl3">
		<m_Name>TOC_Crawl3</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions x_name="toc-toc_crawl4">
		<m_Name>TOC_Crawl4</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions x_name="toc-toc_crawl5">
		<m_Name>TOC_Crawl5</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions x_name="toc-toc_crawl6">
		<m_Name>TOC_Crawl6</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions x_name="toc-toc_crawl7">
		<m_Name>TOC_Crawl7</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Events x_name="toc-ev-attackanim">
		<m_EventName>SetVariable</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>AttackAnim=FALSE</m_ParameterValue>
	</m_Events>
	<m_Events x_name="toc-ev-swing">
		<m_EventName>PlaySwingSound</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue></m_ParameterValue>
	</m_Events>
	<!-- 2026-10-17 ("no alcanzo a golpear a los zombies estando en modo crawl"): sin AttackCollisionCheck el juego nunca
	     comprobaba el golpe. Mismos eventos que el golpe a una mano vanilla (1HDefault.xml). -->
	<m_Events x_name="toc-ev-attackon">
		<m_EventName>AttackAnim</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>TRUE</m_ParameterValue>
	</m_Events>
	<m_Events x_name="toc-ev-hit">
		<m_EventName>AttackCollisionCheck</m_EventName>
		<m_TimePc>0.35</m_TimePc>
		<m_ParameterValue>MeleeSwing</m_ParameterValue>
	</m_Events>
	<m_Events x_name="toc-ev-attackoff">
		<m_EventName>AttackAnim</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>FALSE</m_ParameterValue>
	</m_Events>
	<m_Events x_name="toc-ev-delay">
		<m_EventName>SetMeleeDelay</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>12</m_ParameterValue>
	</m_Events>
	<m_Events x_name="toc-ev-voice">
		<m_EventName>PlayerVoiceSound</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>MeleeAttack</m_ParameterValue>
	</m_Events>
	<m_Transitions>
		<m_Target>A_TOC_CrawlIdle</m_Target>
		<m_blendInTime>0.3</m_blendInTime>
	</m_Transitions>
</animNode>
